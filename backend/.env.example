# =============================================================================
# CryptoTrace AI — Backend Environment Configuration Example
#
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file.
# =============================================================================

APP_ENV=development
APP_NAME=CryptoTrace AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database URLs
DATABASE_URL=postgresql+asyncpg://cryptotrace_user:CHANGE_ME@localhost:5432/cryptotrace_db
DATABASE_SYNC_URL=postgresql+psycopg2://cryptotrace_user:CHANGE_ME@localhost:5432/cryptotrace_db

# CORS Allowlist
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Secret key for local session signing
SECRET_KEY=CHANGE_ME_generate_a_secure_random_value

# Blockchain Providers (Etherscan API V2)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_TIMEOUT_SECONDS=12.0
ETHERSCAN_MAX_RETRIES=3

# Optional future adapters
BLOCKCHAIN_INFO_API_KEY=your_blockchain_info_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
OTXALIENVAULT_API_KEY=your_otx_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
