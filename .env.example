# =============================================================================
# CryptoTrace AI — Environment Variables Example
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file. It is listed in .gitignore.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=CryptoTrace AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Replace placeholders with your actual credentials.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://cryptotrace_user:CHANGE_ME@localhost:5432/cryptotrace_db
# Synchronous URL used only for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://cryptotrace_user:CHANGE_ME@localhost:5432/cryptotrace_db

# ── CORS — allowed origins for the frontend ───────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_value

# ── Blockchain adapters ───────────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BLOCKCHAIN_INFO_API_KEY=your_blockchain_info_api_key_here

# ── Threat intelligence adapters (optional) ───────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
OTXALIENVAULT_API_KEY=your_otx_api_key_here

# ── AI / LLM adapters (optional) ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Frontend (Vite public env — only safe, non-secret values) ────────────────
# These are exposed to the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=CryptoTrace AI
VITE_APP_VERSION=0.1.0
